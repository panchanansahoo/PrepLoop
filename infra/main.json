              ]
            },
            {
              "condition": "[not(empty(parameters('actionGroupEmail')))]",
              "type": "Microsoft.Insights/actionGroups",
              "apiVersion": "2023-01-01",
              "name": "[format('{0}-ops-ag', replace(parameters('grafanaName'), '_', '-'))]",
              "location": "global",
              "tags": "[parameters('tags')]",
              "properties": {
                "groupShortName": "prepops",
                "enabled": true,
                "emailReceivers": [
                  {
                    "name": "ops-email",
                    "emailAddress": "[parameters('actionGroupEmail')]",
                    "useCommonAlertSchema": true
                  }
                ]
              }
            },
            {
              "type": "Microsoft.Insights/metricAlerts",
              "apiVersion": "2018-03-01",
              "name": "[format('{0}-appservice-5xx', replace(parameters('grafanaName'), '_', '-'))]",
              "location": "global",
              "tags": "[parameters('tags')]",
              "properties": {
                "description": "App Service HTTP 5xx alert for preploop backend",
                "severity": 2,
                "enabled": true,
                "scopes": [
                  "[resourceId('Microsoft.Web/sites', parameters('webAppName'))]"
                ],
                "evaluationFrequency": "PT5M",
                "windowSize": "PT5M",
                "criteria": {
                  "allOf": [
                    {
                      "criterionType": "StaticThresholdCriterion",
                      "name": "http5xx-threshold",
                      "metricNamespace": "Microsoft.Web/sites",
                      "metricName": "Http5xx",
                      "operator": "GreaterThan",
                      "timeAggregation": "Total",
                      "threshold": 5
                    }
                  ],
                  "odata.type": "Microsoft.Azure.Monitor.SingleResourceMultipleMetricCriteria"
                },
                "autoMitigate": true,
                "targetResourceType": "Microsoft.Web/sites",
                "targetResourceRegion": "[parameters('location')]",
                "actions": "[if(not(empty(parameters('actionGroupEmail'))), createArray(createObject('actionGroupId', resourceId('Microsoft.Insights/actionGroups', format('{0}-ops-ag', replace(parameters('grafanaName'), '_', '-'))))), createArray())]"
              },
              "dependsOn": [
                "[resourceId('Microsoft.Insights/actionGroups', format('{0}-ops-ag', replace(parameters('grafanaName'), '_', '-')))]"
              ]
            }
          ],
          "outputs": {
            "logAnalyticsWorkspaceId": {
              "type": "string",
              "value": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsWorkspaceName'))]"
            },
            "monitorWorkspaceId": {
