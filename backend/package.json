{
    "name": "@preploop/backend",
    "version": "1.0.0",
    "description": "Backend for Preploop",
    "main": "index.js",
    "type": "module",
    "engines": {
        "node": "24.x"
    },
    "scripts": {
        "start": "node index.js",
        "dev": "node --watch-path=./routes --watch-path=./services --watch-path=./utils --watch-path=./middleware --watch-path=./config --watch-path=./index.js index.js",
        "setup": "node setup.js",
        "lint": "node --check index.js && node --check setup.js && eslint .",
        "lint:fix": "echo 'Run prettier to format code'",
        "format": "prettier --write \"**/*.js\"",
        "test": "node scripts/testStartup.js && node scripts/testVoiceServiceUnit.js && node scripts/testInterviewStateMachine.js && node scripts/testScoringAndFollowUp.js && node scripts/testInterviewGrounding.js && node scripts/testInterviewGroundingService.js && node scripts/testInterviewTelemetry.js && node scripts/testInterviewTelemetryService.js && node scripts/testInterviewConversationService.js && node scripts/testInterviewOrchestration.js && node scripts/testInterviewScoringRules.js && node scripts/testInterviewImprovements.js && node scripts/testInterviewIntelligence.js && node scripts/testSecurityFixes.js && node scripts/testProfilePayloadNormalization.js && node scripts/test_profile_endpoints.js && node scripts/testPortfolioProfileNormalizerService.js && node scripts/testPortfolioLinkedinService.js && node scripts/testPortfolioRendererService.js",
        "test:all": "npm run test && node scripts/testInterviewFeedback.js && node scripts/testVoiceInterviewIntelligence.js && node scripts/testCareerOpsSerialization.js && node scripts/testCareerOpsHistory.js && npm run test:auth && npm run test:payment && npm run smoke:interview-flows",
        "test:auth": "node scripts/testAuthFlow.js",
        "test:payment": "node scripts/testPaymentFlow.js",
        "smoke:interview-flows": "node scripts/smokeInterviewFlows.js",
        "test:voice:unit": "node scripts/testVoiceServiceUnit.js",
        "test:interview:state-machine": "node scripts/testInterviewStateMachine.js",
        "test:interview:scoring": "node scripts/testScoringAndFollowUp.js",
        "test:interview:orchestration": "node scripts/testInterviewOrchestration.js",
        "test:interview:grounding": "node scripts/testInterviewGrounding.js",
        "test:interview:feedback": "node scripts/testInterviewFeedback.js",
        "test:interview:telemetry": "node scripts/testInterviewTelemetry.js",
        "test:interview:telemetry-service": "node scripts/testInterviewTelemetryService.js",
        "test:voice:telemetry": "node scripts/testVoiceTelemetry.js",
        "test:career-ops:serialization": "node scripts/testCareerOpsSerialization.js",
        "smoke:interview-suite": "node scripts/smokeInterviewSuite.js",
        "smoke:interview-suite:local": "node scripts/runInterviewSuiteSmokeLocal.js",
        "smoke:company-interview:auth": "node scripts/smokeCompanyInterviewAuth.js",
        "smoke:ai-features": "node scripts/smokeAIFeatures.js",
        "smoke:fresher-technical": "node scripts/smokeFresherTechnicalInterview.js",
        "smoke:portfolio": "node scripts/smokePortfolioApi.js",
        "smoke:career-ops": "node scripts/smokeCareerOps.js",
        "smoke:career-ops:history": "node scripts/testCareerOpsHistory.js",
        "smoke:dsa-editor": "node scripts/smokeDsaCodeEditor.js",
        "test:blog:admin": "node scripts/testAdminBlog.js",
        "test:coin:atomicity": "node scripts/test_coin_atomicity.js",
        "test:coin:integration": "node scripts/test_coin_integration.js",
        "test:coins": "npm run test:coin:integration && npm run test:coin:atomicity",
        "test:security-fixes": "node scripts/testSecurityFixes.js",
        "migrate:coin:real-data": "node scripts/apply_coin_real_data_sync_migration.js",
        "migrate:quiz-feature": "node scripts/apply_quiz_feature_migration.js",
        "verify:quiz-feature": "node scripts/verify_quiz_feature_migration.js",
        "coins:reconcile": "node scripts/reconcile_coin_balances_via_api.js",
        "test:ai-features": "node scripts/test-ai-features.js",
        "verify:migration": "node scripts/verify-ai-features-migration.js",
        "test:career": "node scripts/testPrepLoopCareerService.js",
        "test:aiml:career": "node scripts/testAimlCareerGuidance.js",
        "test:copilot": "node scripts/test-copilot.js",
        "test:circuit-breaker": "node tests/circuitBreaker.test.js"
    },
    "dependencies": {
        "@google/genai": "^1.50.1",
        "@supabase/supabase-js": "^2.95.3",
        "@upstash/redis": "^1.37.0",
        "ajv": "^8.12.0",
        "ajv-formats": "^2.1.1",
        "bcryptjs": "^3.0.3",
        "compression": "^1.8.1",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.21.2",
        "express-rate-limit": "^7.5.1",
        "express-validator": "^7.0.1",
        "groq-sdk": "^1.3.0",
        "helmet": "^7.2.0",
        "iconv-lite": "0.7.2",
        "joi": "^18.1.2",
        "jsonwebtoken": "^9.0.3",
        "kokoro-js": "^1.2.1",
        "libmime": "5.3.8",
        "multer": "^2.0.0",
        "node-cache": "^5.1.2",
        "node-edge-tts": "^1.2.10",
        "nodemailer": "^9.0.1",
        "pdf-parse": "^1.1.1",
        "pg": "^8.18.0",
        "razorpay": "^2.9.6",
        "readable-stream": "^4.7.0",
        "redis": "^5.12.1",
        "winston": "^3.19.0",
        "ws": "^8.20.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.4.1",
        "globals": "^17.6.0"
    }
}
