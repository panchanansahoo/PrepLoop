{
    "name": "preploop-backend",
    "version": "1.0.0",
    "description": "Backend for Preploop",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "start": "node index.js",
        "dev": "node --watch index.js",
        "setup": "node setup.js",
        "lint": "node --check index.js && node --check scripts/testStartup.js && node --check scripts/smokeInterviewSuite.js && node --check scripts/runInterviewSuiteSmokeLocal.js",
        "test": "node scripts/testStartup.js",
        "smoke:interview-suite": "node scripts/smokeInterviewSuite.js",
        "smoke:interview-suite:local": "node scripts/runInterviewSuiteSmokeLocal.js",
        "smoke:ai-features": "node scripts/smokeAIFeatures.js",
        "test:blog:admin": "node ../test-admin-blog.js",
        "test:coin:atomicity": "node scripts/test_coin_atomicity.js",
        "test:coin:integration": "node scripts/test_coin_integration.js",
        "test:coins": "npm run test:coin:integration && npm run test:coin:atomicity",
        "test:ai-features": "node scripts/test-ai-features.js",
        "verify:migration": "node scripts/verify-ai-features-migration.js"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.95.3",
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.21.2",
        "express-rate-limit": "^7.5.1",
        "express-validator": "^7.0.1",
        "groq-sdk": "^0.37.0",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.3",
        "mailparser": "^3.9.6",
        "multer": "^1.4.5-lts.1",
        "nodemailer": "^8.0.4",
        "pdf-parse": "^1.1.1",
        "pg": "^8.18.0",
        "razorpay": "^2.9.6"
    }
}
