# App
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Supabase (required)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI (required for AI routes)
GROQ_API_KEY=your_groq_api_key

# Email (optional)
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password

# CAPTCHA (optional)
RECAPTCHA_SECRET_KEY=your_recaptcha_secret

# Voice (optional)
ELEVENLABS_API_KEY=your_elevenlabs_key
DEEPGRAM_API_KEY=your_deepgram_key

# Pipecat bridge (optional, needed for full_realtime transport)
# Example: https://your-pipecat-bridge.example.com
PIPECAT_BRIDGE_URL=
# Optional explicit template. Available placeholders: {sessionId}, {userId}, {interviewSessionId}
# Example: wss://your-pipecat-bridge.example.com/ws?sessionId={sessionId}&userId={userId}
PIPECAT_BRIDGE_WS_TEMPLATE=
PIPECAT_SESSION_TTL_MINUTES=30

# Jobs integrations (optional)
RAPIDAPI_KEY=your_rapidapi_key
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# Payments (optional)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Migration utility (optional)
SUPABASE_DB_PASSWORD=your_supabase_db_password
SUPABASE_KEY=your_supabase_key
