# ============================================
# Preploop — Free Forever Stack Configuration
# ============================================
# All services use permanent free tiers.
# Total recurring cost: $0/month.
# ============================================

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret (MUST be at least 32 characters)
JWT_SECRET=your_jwt_secret_here

# ── Database: Supabase (Free Tier — 500MB DB, 50K MAU) ──
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_DB_PASSWORD=your_supabase_db_password_here

# Frontend Supabase Config
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_API_URL=http://localhost:5000

# ── AI: LLM Providers (Both Free Tier) ──
# Primary: Google Gemini 2.5 Flash (~10 RPM, ~250 RPD)
GEMINI_API_KEY=your_gemini_api_key_here

# Secondary: Groq (~30 RPM, used for interviews/chat)
GROQ_API_KEY=your_groq_api_key_here

# ── Cache: Upstash Redis (Free Tier — 500K cmds/mo) ──
# Sign up at https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Payments: Razorpay (Test Mode) ──
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ── Voice AI ──
# TTS Premium (Human Voice)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# TTS Free Options: Kokoro runs locally (free, no API key needed)
# TTS Fallback: Groq Orpheus (uses GROQ_API_KEY above)
# STT: Client-side Web Speech API (free, no config needed)

# ── Email: Brevo SMTP (Free Tier — 300 emails/day) ──
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user_here
SMTP_PASS=your_smtp_password_here

# ── Jobs API ──
# Adzuna (Free Tier)
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# RapidAPI JSearch (Optional)
RAPIDAPI_KEY=your_rapidapi_key_here

# ── Frontend URL (for CORS) ──
FRONTEND_URL=http://localhost:5173

# Production CORS (set these in your production environment)
# PRODUCTION_FRONTEND_URL=https://www.preploop.me
# PRODUCTION_DOMAIN=preploop.me
# STAGING_FRONTEND_URL=https://staging.preploop.me

# ── Optional ──
# reCAPTCHA v3 (leave empty to disable)
RECAPTCHA_SECRET_KEY=
