# App
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Supabase (required)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI (required for AI routes)
GROQ_API_KEY=your_groq_api_key

# Email (optional)
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password

# CAPTCHA (optional)
RECAPTCHA_SECRET_KEY=your_recaptcha_secret

# Voice (optional — Kokoro TTS runs locally, no key needed)
DEEPGRAM_API_KEY=your_deepgram_key


# Jobs integrations (optional)
RAPIDAPI_KEY=your_rapidapi_key
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# Payments (optional)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Migration utility (optional)
SUPABASE_DB_PASSWORD=your_supabase_db_password
SUPABASE_KEY=your_supabase_key

# Testing (optional — only needed when running test-email-verification.js)
TEST_USER_PASSWORD=your_test_password
TEST_API_URL=http://localhost:5001/api/auth
