{
  "installCommand": "npm ci && cd frontend && npm ci",
  "buildCommand": "cd frontend && node ./node_modules/vite/bin/vite.js build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://preploop-api-staging.azurewebsites.net/api/:path*"
    }
  ],
  "regions": [
    "iad1"
  ]
}
