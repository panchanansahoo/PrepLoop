{
    "name": "preploop-frontend",
    "version": "1.0.0",
    "description": "Frontend for Preploop",
    "type": "module",
    "engines": {
        "node": "24.x"
    },
    "scripts": {
        "dev": "vite",
        "build": "node node_modules/vite/bin/vite.js build",
        "lint": "node node_modules/eslint/bin/eslint.js src",
        "lint:fix": "node node_modules/eslint/bin/eslint.js src --fix",
        "format": "prettier --write \"src/**/*.{js,jsx}\"",
        "preview": "vite preview",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:report": "playwright show-report"
    },
    "dependencies": {
        "@blocknote/core": "^0.46.2",
        "@blocknote/mantine": "^0.46.2",
        "@blocknote/react": "^0.46.2",
        "@mantine/core": "^8.3.15",
        "@mantine/hooks": "^8.3.15",
        "@react-three/drei": "^9.122.0",
        "@react-three/fiber": "^8.18.0",
        "@supabase/supabase-js": "^2.95.3",
        "@tiptap/core": "^3.19.0",
        "@tiptap/extension-image": "^3.19.0",
        "@tiptap/extension-link": "^3.19.0",
        "@tiptap/extension-placeholder": "^3.19.0",
        "@tiptap/extension-task-item": "^3.19.0",
        "@tiptap/extension-task-list": "^3.19.0",
        "@tiptap/extension-underline": "^3.19.0",
        "@tiptap/react": "^3.19.0",
        "@tiptap/starter-kit": "^3.19.0",
        "@tiptap/suggestion": "^3.19.0",
        "axios": "^1.6.7",
        "clsx": "^2.1.1",
        "dagre": "^0.8.5",
        "diff": "^9.0.0",
        "dompurify": "^3.4.0",
        "lucide-react": "^0.323.0",
        "prettier": "^3.8.1",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-markdown": "^10.1.0",
        "react-resizable-panels": "^4.11.1",
        "react-router-dom": "^6.22.0",
        "react-syntax-highlighter": "^16.1.1",
        "reactflow": "^11.11.4",
        "tailwind-merge": "^3.4.1",
        "three": "^0.182.0",
        "tippy.js": "^6.3.7",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@eslint/js": "^9.22.0",
        "@fullhuman/postcss-purgecss": "^8.0.0",
        "@monaco-editor/react": "^4.7.0",
        "@playwright/test": "^1.59.1",
        "@tailwindcss/postcss": "^4.1.18",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@vitejs/plugin-react": "^4.2.1",
        "@vitest/coverage-v8": "^4.1.7",
        "autoprefixer": "^10.4.24",
        "concurrently": "^8.2.2",
        "eslint": "^10.6.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.19",
        "globals": "^16.0.0",
        "jsdom": "^28.1.0",
        "postcss": "^8.5.6",
        "puppeteer": "^24.40.0",
        "rollup-plugin-visualizer": "^7.0.1",
        "tailwindcss": "^4.1.18",
        "vite": "^6.0.0",
        "vitest": "^4.0.18"
    },
    "overrides": {
        "uuid": "^11.0.0",
        "three-mesh-bvh": "^0.8.0"
    }
}
