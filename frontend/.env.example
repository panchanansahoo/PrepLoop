# ============================================
# PrepLoop Frontend Environment Configuration
# ============================================

# Backend API Base URL
# Development default: http://localhost:5000
# Production: Leave empty if using reverse proxy (/api/*) or set full origin e.g. https://api.preploop.me
VITE_API_URL=http://localhost:5000

# Backend WebSocket URL
# Development default: ws://localhost:5000
# Production: wss://api.preploop.me
VITE_WS_URL=ws://localhost:5000

# Supabase Authentication & Client Configuration
# Obtain from Supabase Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: Razorpay Key ID for client-side checkout
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
