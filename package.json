{
  "name": "preploop-root",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node scripts/devRunner.js",
    "discord:install": "npm install --prefix discord-bot",
    "discord:dev": "npm run dev --prefix discord-bot",
    "discord:start": "npm run start --prefix discord-bot",
    "discord:deploy": "npm run deploy --prefix discord-bot",
    "discord:bootstrap": "npm run bootstrap --prefix discord-bot",
    "discord:setup-env": "npm run setup-env --prefix discord-bot",
    "discord:prepare": "npm run prepare --prefix discord-bot",
    "discord:doctor": "npm run doctor --prefix discord-bot",
    "discord:check": "npm run check --prefix discord-bot",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "start": "npm run dev",
    "setup:env": "node scripts/bootstrapSetup.js",
    "setup": "node scripts/bootstrapSetup.js --verify",
    "verify:setup": "node scripts/verifySetup.js",
    "verify:setup:strict": "node scripts/verifySetup.js --strict",
    "test:improvements": "node scripts/testImprovements.js",
    "test:all-improvements": "node scripts/testAllImprovements.js",
    "test:quick": "node scripts/quickTest.js",
    "improvements:install": "node scripts/installImprovements.js",
    "blog:test:admin": "npm --prefix backend run test:blog:admin",
    "test:blog:admin": "npm run blog:test:admin",
    "smoke:interview-suite": "npm --prefix backend run smoke:interview-suite:local",
    "lint": "npm run lint --prefix backend && npm run lint --prefix frontend",
    "lint:fix": "npm run lint:fix --prefix backend && npm run lint:fix --prefix frontend",
    "format": "npm run format --prefix backend && npm run format --prefix frontend",
    "scan:secrets": "node scripts/scan-secrets.js",
    "redis:guardrails": "node scripts/redis-azure-guardrails.mjs",
    "redis:guardrails:strict": "node scripts/redis-azure-guardrails.mjs --strict",
    "backup:db": "node backend/scripts/backup-db.js",
    "monitor:health": "node backend/scripts/health-monitor.js",
    "generate:jwt": "node scripts/generate-jwt-secrets.js",
    "test:fixes": "node scripts/test-critical-fixes.js",
    "test": "npm run test --prefix backend && npm run test --prefix frontend",
    "build": "npm run build --prefix frontend",
    "audit": "npm audit --omit=dev --prefix backend && npm audit --omit=dev --prefix frontend",
    "test:e2e": "npm run test:e2e --prefix frontend",
    "docs:api": "node backend/scripts/generateApiDocs.js",
    "cache:clear": "node backend/scripts/clearCache.js",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "k8s:deploy": "kubectl apply -f k8s/deployment.yaml",
    "k8s:status": "kubectl get pods -n preploop",
    "docs:generate": "node backend/utils/apiDocGenerator.js",
    "cache:stats": "node backend/scripts/cacheStats.js",
    "security:audit": "node backend/scripts/securityAudit.js",
    "performance:report": "node backend/scripts/performanceReport.js",
    "collaboration:test": "node backend/scripts/testCollaboration.js"
  }
}
