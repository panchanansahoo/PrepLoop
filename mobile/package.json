{
    "name": "preploop-mobile",
    "version": "1.0.0",
    "description": "PrepLoop Android App - AI-powered interview preparation",
    "main": "node_modules/expo/AppEntry.js",
    "scripts": {
        "start": "expo start",
        "android": "expo run:android",
        "android:apk": "node ./scripts/run-gradle.cjs assembleDebug -x lint -x test -PreactNativeArchitectures=arm64-v8a",
        "android:apk:universal": "node ./scripts/run-gradle.cjs assembleDebug -x lint -x test",
        "android:apk:release": "node ./scripts/run-gradle.cjs assembleRelease -x lint -x test -PreactNativeArchitectures=arm64-v8a",
        "prebuild": "expo prebuild --platform android --no-install",
        "prebuild:clean": "expo prebuild --platform android --clean --no-install",
        "ios": "expo run:ios",
        "web": "expo start --web",
        "lint": "eslint src --ext .js,.jsx",
        "lint:fix": "eslint src --ext .js,.jsx --fix"
    },
    "dependencies": {
        "@react-native-async-storage/async-storage": "^2.2.0",
        "@react-native-masked-view/masked-view": "^0.3.2",
        "@react-navigation/bottom-tabs": "^6.6.1",
        "@react-navigation/native": "^6.1.18",
        "@react-navigation/native-stack": "^6.11.0",
        "@supabase/supabase-js": "^2.45.4",
        "axios": "^1.7.7",
        "expo": "~54.0.0",
        "expo-av": "~16.0.8",
        "expo-clipboard": "~8.0.8",
        "expo-constants": "~18.0.13",
        "expo-device": "~8.0.10",
        "expo-document-picker": "~14.0.8",
        "expo-file-system": "~19.0.22",
        "expo-font": "~14.0.11",
        "expo-haptics": "~15.0.8",
        "expo-linear-gradient": "~15.0.8",
        "expo-linking": "~8.0.12",
        "expo-notifications": "^0.32.17",
        "expo-secure-store": "~15.0.8",
        "expo-splash-screen": "~31.0.13",
        "expo-status-bar": "~3.0.9",
        "expo-system-ui": "~6.0.9",
        "expo-web-browser": "~15.0.11",
        "react": "^19.1.0",
        "react-native": "^0.81.5",
        "react-native-chart-kit": "^6.12.2",
        "react-native-gesture-handler": "~2.28.0",
        "react-native-reanimated": "~4.1.1",
        "react-native-safe-area-context": "~5.6.0",
        "react-native-screens": "~4.16.0",
        "react-native-svg": "^15.12.1",
        "react-native-vector-icons": "^10.2.0",
        "react-native-webview": "^13.15.0",
        "react-native-worklets": "^0.5.1"
    },
    "overrides": {
        "postcss": "^8.5.10"
    },
    "devDependencies": {
        "@babel/core": "^7.24.0",
        "@eslint/js": "^9.0.0",
        "eslint": "^8.57.1",
        "eslint-plugin-react": "^7.34.0",
        "eslint-plugin-react-hooks": "^4.6.0",
        "eslint-plugin-react-native": "^4.1.0"
    }
}
