# Mobile App Environment Variables
# Copy this file to .env and configure your values before building.

# PrepLoop Backend API URL
# - Android Emulator: http://10.0.2.2:5000 (host machine localhost)
# - iOS Simulator:    http://localhost:5000
# - Physical device:  https://api.preploop.me  (your deployed backend)
# - Production builds: set to your live backend URL; never use localhost.
EXPO_PUBLIC_API_URL=https://api.preploop.me

# Supabase Credentials
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
