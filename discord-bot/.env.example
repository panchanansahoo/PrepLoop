# Discord bot credentials
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
# Optional: set for faster guild-scoped command updates during development
DISCORD_GUILD_ID=your_discord_guild_id_here

# Preploop backend base URL (no trailing slash)
PREPLOOP_API_URL=http://localhost:5000

# Optional override for chat command coin guidance
AI_CHAT_COIN_COST=5

# Enable daily challenge auto posting to daily-* channels
ENABLE_DAILY_POSTER=true
DAILY_POST_HOUR_UTC=5
DAILY_CHANNEL_DSA=daily-dsa
DAILY_CHANNEL_APTITUDE=daily-aptitude
DAILY_CHANNEL_LLD=daily-lld
DAILY_HINT_DELAY_HOURS=6
DAILY_EDITORIAL_DELAY_HOURS=12

# Send a quick-start DM checklist to new members
ENABLE_ONBOARDING_DM=false

# Monitor unresolved help threads and ping Mentor role after SLA
ENABLE_HELP_SLA_MONITOR=true
HELP_SLA_MINUTES=45
HELP_SLA_SCAN_MS=300000
HELP_SLA_CHANNELS=dsa-help,aptitude-help,lld-help,interview-help
HELP_SLA_RESOLVER_ROLES=Mentor,Moderator,Admin,Event Host
